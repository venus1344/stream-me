# ── SERVER ────────────────────────────────────────────────────────────────────
# Shared between api and worker — must be identical on both
JWT_SECRET=change-me-use-a-64-char-random-string
JWT_EXPIRE_HOURS=24

# PostgreSQL (used by api service)
POSTGRES_PASSWORD=change-me

# ── WORKER ────────────────────────────────────────────────────────────────────
# Upload size limit in bytes (default 10 GB)
UPLOAD_MAX_BYTES=10737418240

# Model B: which tenant this worker serves (users of other tenants are rejected).
# Leave empty for the legacy single-tenant behaviour.
TENANT_ID=

# OME
OME_HOST=stream.example.com
OME_WEBRTC_UDP_CANDIDATE_PORT=10000
OME_WEBRTC_TCP_CANDIDATE_PORT=10000
OME_WEBRTC_TCP_RELAY_PORT=3478

# OBS publishes to rtmp://HOST:1936/stream with this key.
# The relay republishes it to the `restream` app below, which is the URL the
# restream engine consumes from AND probes to decide live vs offline.
RELAY_INPUT_APP=restream
RELAY_INPUT_STREAM_KEY=input
RELAY_INPUT_HOST=127.0.0.1:1936

# Live-detection probe (leave unset to follow RELAY_INPUT_* above)
# OBS_RELAY_HEALTH_URL=

# Relay republishes to OME
OME_RELAY_APP=app
OME_RELAY_STREAM_KEY=key
OME_RTMP_HOST=127.0.0.1:1935

# YouTube restream (optional)
YOUTUBE_RTMPS_URL=rtmps://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=
YOUTUBE_VIDEO_BITRATE_KBPS=6000
YOUTUBE_MAXRATE_KBPS=6000
YOUTUBE_BUFSIZE_KBPS=12000
YOUTUBE_AUDIO_BITRATE_KBPS=160
YOUTUBE_FPS=30
YOUTUBE_GOP_SECONDS=2
YOUTUBE_PRESET=veryfast

# Facebook restream (optional)
FACEBOOK_RTMPS_URL=rtmps://live-api-s.facebook.com:443/rtmp
FACEBOOK_STREAM_KEY=

# Instagram restream (optional)
INSTAGRAM_RTMPS_URL=rtmps://live-upload.instagram.com:443/rtmp
INSTAGRAM_STREAM_KEY=
